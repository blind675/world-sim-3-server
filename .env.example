PORT=4000
SNAPSHOT_DIR=./data
SNAPSHOT_INTERVAL_TICKS=6
# Optional: absolute path to a validated JSON catalogue. The checked-in
# config/object-catalog.json is used by default.
# OBJECT_CATALOG_PATH=./config/object-catalog.json
# Required in production. Set a strong random value in deployment secrets.
# CONTROL_API_TOKEN=
CORS_ORIGIN=http://localhost:3000,https://terraria-sim.netlify.app

# World generation
WORLD_SEED=20260420
WORLD_WIDTH=5120
WORLD_HEIGHT=5120
WORLD_CELL_SIZE=1
WORLD_CHUNK_SIZE=64
TERRAIN_CACHE_MAX_CHUNKS=256

# Terrain height range (meters)
TERRAIN_MIN_HEIGHT=-10
TERRAIN_MAX_HEIGHT=80

# Simulation: 10 seconds locally; production defaults to 20 seconds.
# Keep 360 ticks/day: 20 seconds/tick makes one simulated day take 2 real hours.
SIM_TICK_MS=10000
SIM_TICKS_PER_DAY=360
MOVE_CELLS_PER_STEP=32
# Only needed when migrating a snapshot written with a custom old tick interval.
# SNAPSHOT_PREVIOUS_TICK_MS=

# Cassowary-inspired survival defaults are derived from SIM_TICKS_PER_DAY:
# food becomes fatal after 7 days without eating; water after 3 days.
# Rest can begin after roughly 0.7 days awake and is not directly lethal.
# HUNGER_DECAY_RATE=
# THIRST_DECAY_RATE=
# TIREDNESS_DECAY_RATE=
FRUIT_HYDRATION=0.2

# Perception (Milestone 4)
VISION_CONE_DEG=100
VISION_NEAR_RADIUS=4
MEMORY_DECAY_FLOOR=0.02

# Memory clustering (Milestone 4 extension)
# Max pairwise cell distance for same-type memories to be grouped.
MEMORY_CLUSTER_RADIUS=4
# Minimum number of individuals required to collapse into a cluster.
MEMORY_CLUSTER_MIN_COUNT=3
# How many times slower clusters decay vs individuals (100 = near-permanent).
MEMORY_CLUSTER_DECAY_MULT=100
